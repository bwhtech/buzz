{
	"compilerOptions": {
		"target": "ES6",
		"module": "esnext",
		"strict": true,
		"jsx": "preserve",
		"importHelpers": true,
		"moduleResolution": "bundler",
		"experimentalDecorators": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"useDefineForClassFields": true,
		"resolveJsonModule": true,
		// Resolves the linked @framework/ui's imports from this app's node_modules.
		"preserveSymlinks": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"sourceMap": true,
		"baseUrl": ".",
		"types": ["node"],
		"paths": {
			"@/*": ["src/*"],
			"@public/*": ["../buzz/public/*"],
			"@framework/ui/telemetry": ["node_modules/@framework/ui/src/telemetry/index.ts"],
			"tslib": ["/node_modules/tslib/tslib.d.ts"],
			"maplibre-gl": ["node_modules/maplibre-gl"],
			"cobe": ["node_modules/cobe"]
		},
		"lib": ["esnext", "dom", "dom.iterable", "scripthost"]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"src/**/*.vue",
		"../buzz/public/js/**/*.ts",
		"tests/**/*.ts",
		"tests/**/*.tsx",
		"vite.config.ts",
		"frappe-ui-vite.d.ts"
	],
	"exclude": ["node_modules"]
}
