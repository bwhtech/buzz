{
 "doctype": "DocType",
 "engine": "InnoDB",
 "module": "Events",
 "autoname": "hash",
 "naming_rule": "Random",
 "track_changes": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "name": "Buzz Form Field",
 "istable": 1,
 "editable_grid": 1,
 "fields": [
  {
   "fieldname": "enabled",
   "label": "Enabled",
   "fieldtype": "Check",
   "default": "1"
  },
  {
   "fieldname": "label",
   "label": "Label",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "fieldname",
   "label": "Fieldname",
   "fieldtype": "Data",
   "reqd": 1
  },
  {
   "fieldname": "column_break_question",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "fieldtype",
   "label": "Type",
   "fieldtype": "Select",
   "reqd": 1,
   "default": "Data",
   "in_list_view": 1,
   "options": "Data\nCheck\nSmall Text\nPhone\nEmail\nSelect\nDate\nNumber\nMulti Select\nRating\nAttach\nAttach Image"
  },
  {
   "fieldname": "asked_per",
   "label": "Asked Per",
   "fieldtype": "Select",
   "options": "Booking\nAttendee",
   "default": "Attendee",
   "depends_on": "eval:parent.form_doctype=='Event Booking'",
   "description": "Booking questions are asked once per booking, Attendee questions once per attendee."
  },
  {
   "fieldname": "mandatory",
   "label": "Required",
   "fieldtype": "Check",
   "default": "0",
   "in_list_view": 1
  },
  {
   "fieldname": "options",
   "label": "Options",
   "fieldtype": "Small Text",
   "description": "One option per line for Select and Multi Select."
  },
  {
   "fieldname": "placeholder",
   "label": "Placeholder",
   "fieldtype": "Data"
  },
  {
   "fieldname": "default_value",
   "label": "Default Value",
   "fieldtype": "Data"
  },
  {
   "fieldname": "description",
   "label": "Help Text",
   "fieldtype": "Small Text",
   "description": "Shown under the question."
  },
  {
   "fieldname": "section_break_conditions",
   "label": "Conditions",
   "fieldtype": "Section Break",
   "collapsible": 1
  },
  {
   "fieldname": "depends_on",
   "label": "Show When",
   "fieldtype": "JSON",
   "description": "List of [fieldname, operator, value] triples that must all match. Empty means always shown."
  },
  {
   "fieldname": "mandatory_depends_on",
   "label": "Required When",
   "fieldtype": "JSON",
   "description": "Same format as Show When. The question is required when all triples match."
  }
 ],
 "field_order": [
  "enabled",
  "label",
  "fieldname",
  "column_break_question",
  "fieldtype",
  "asked_per",
  "mandatory",
  "options",
  "placeholder",
  "default_value",
  "description",
  "section_break_conditions",
  "depends_on",
  "mandatory_depends_on"
 ],
 "permissions": []
}
